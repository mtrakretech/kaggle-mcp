# Kaggle MCP Server — Environment Configuration
# Copy this to .env and fill in your credentials.

# Get your API key at: https://www.kaggle.com/settings/api
# (Click "Create New Token" — download kaggle.json, copy the "key" value)

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key_here

# Both KAGGLE_KEY and KAGGLE_API_TOKEN are set automatically.
# KAGGLE_API_TOKEN is the same value as KAGGLE_KEY (KGAT_... format)

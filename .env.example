# Kaggle MCP Server credentials
# Prefer:  python kaggle_mcp.py --setup
# NEVER commit .env
#
# Create token: https://www.kaggle.com/settings -> API -> Create New Token
# Downloads kaggle.json: {"username":"...","key":"..."}

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key_here

# kaggle CLI v2.2.3+ (same value as KAGGLE_KEY)
KAGGLE_API_TOKEN=your_kaggle_api_key_here
